# Search and Ingestion Settings
SEARCH_HASHTAGS=#nifty50,#sensex,#banknifty,#intraday
MAX_TWEETS=2000

# Browser Automation Settings
HEADLESS=true
SCROLL_DELAY=2.0
MAX_SCROLLS=1000
PAGE_LOAD_TIMEOUT=30

# Storage Paths
OUTPUT_DIR=data
RAW_DATA_DIR=data/raw
PROCESSED_DATA_DIR=data/processed

# Logging
LOG_LEVEL=INFO
